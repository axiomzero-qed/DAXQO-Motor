{
  "mcpServers": {
    "daxqo_motor": {
      "command": "/absolute/path/to/venv/python",
      "args": [
        "-m",
        "motor.mcp_server",
        "--adapter",
        "motor.demo:create_adapter",
        "--map-db",
        "/absolute/path/to/map.sqlite3",
        "--source",
        "my_harness"
      ]
    }
  }
}
