include LICENSE README.md CONTRIBUTING.md
recursive-include docs *.md
recursive-include schema *.json
recursive-include examples *.py *.json
recursive-include native *.java *.md
recursive-include motor/_vendor *.json
recursive-include scripts *.py *.ps1
recursive-include tests *.py
recursive-include android-fixture *.md *.gradle *.xml *.java *.ps1
prune android-fixture/app/build
prune android-fixture/.gradle
prune android-fixture/dist
prune data
prune dist
prune exports
global-exclude *.py[cod] __pycache__ *.sqlite3* .env *.apk *.class *.log
